#!name = 拦截链路探针（带对照组）
#!desc = 只做诊断。同时监控 www.baidu.com（对照组）和 *.manmanbuy.com（目标）。\n测试：先打开百度，再打开慢慢买。\n两个都没通知 = 探针插件没生效；只有百度有 = manmanbuy 的 MITM 有问题；都有 = 链路全通。\n排查完请卸载。
#!system = ios

# ============================================================
# 语法与已验证可用的 fanqie.plugin 保持一致（legacy 写法 + %APPEND%）
# ============================================================

[Script]
# 对照组：百度
http-request ^https?://www\.baidu\.com/ script-path=https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/mmb_probe.js, requires-body=true, max-size=0, timeout=30

# 目标：慢慢买全域名
http-request ^https?://([a-z0-9-]+\.)*manmanbuy\.com/ script-path=https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/mmb_probe.js, requires-body=true, max-size=0, timeout=30

[MITM]
hostname = %APPEND% *.manmanbuy.com, manmanbuy.com, www.baidu.com
