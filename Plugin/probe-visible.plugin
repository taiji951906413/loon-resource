#!name = 可见性探针（不依赖通知）
#!desc = 只做诊断。装上后用 Safari 打开 https://www.baidu.com：\n如果页面被替换成黑底大字「脚本执行正常」→ 拦截+脚本下载+脚本执行 三段全通；\n如果百度正常显示 → 脚本没被执行。\n排查完请卸载。
#!system = ios

# ============================================================
# 为什么用「改写页面」而不是弹通知：
#   iOS 设置里如果关掉了 Loon 的通知权限，脚本即使跑了也不会弹窗，
#   会误判成「脚本没执行」。改写响应体不受通知权限影响，看到就算数。
# ============================================================

[Script]
http-response ^https?://www\.baidu\.com/ script-path=https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/probe_visible.js, requires-body=true, max-size=0, timeout=30

[Mitm]
hostname = %APPEND% www.baidu.com, *.manmanbuy.com, manmanbuy.com
