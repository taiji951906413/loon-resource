#!name = 链路探针（二分定位）
#!desc = 只做诊断，排查完请卸载。\n测试顺序：\n① 打开 http://neverssl.com —— 纯 HTTP，不需要 MITM 解密。页面被替换 = 脚本引擎正常\n② 打开 https://www.baidu.com —— HTTPS，需要 MITM。页面被替换 = 解密正常\n③ 打开 https://www.manmanbuy.com —— 目标站点\n把三步分别的结果告诉我就行。
#!system = ios
#!loon_version = 3.5.2(1005)

# ============================================================
# 为什么要三个测试点：
#   纯 HTTP 请求不经过证书解密，Loon 直接就能执行脚本。
#   如果 neverssl 能改写、baidu 不能改写，说明问题卡在 MITM 解密
#   （证书未信任，或站点走 HTTP/3 QUIC 导致 Loon 无法解密）。
#   如果两个都不能改写，说明脚本引擎/插件本身没生效。
# ============================================================

[Script]
# ① 纯 HTTP 对照组：不依赖 MITM
response if ${url} ~= /^http:\/\/neverssl\.com\//i then script("https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/probe_visible.js") with tag="[探针]HTTP对照", requires_body=true

# ② HTTPS 对照组：依赖 MITM 解密
response if ${url} ~= /^https?:\/\/www\.baidu\.com\//i then script("https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/probe_visible.js") with tag="[探针]百度", requires_body=true

# ③ 目标：慢慢买请求记录
request if ${url} ~= /^https?:\/\/([a-z0-9-]+\.)*manmanbuy\.com\//i then script("https://raw.githubusercontent.com/taiji951906413/loon-resource/refs/heads/main/Script/mmb_probe.js") with tag="[探针]慢慢买请求", requires_body=true

[MitM]
hostname = %APPEND% www.baidu.com, *.manmanbuy.com, manmanbuy.com
